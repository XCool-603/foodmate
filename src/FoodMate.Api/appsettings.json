{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=foodmate.dev.db"
  },

  "Auth": {
    "Jwt": {
      "Issuer": "foodmate",
      "Audience": "foodmate-client",
      "//SigningKey": "必须通过环境变量 Auth__Jwt__SigningKey 注入（≥32 字节），绝不写入仓库",
      "SigningKey": "",
      "AccessTokenMinutes": 120,
      "RefreshTokenDays": 30,
      "ClockSkewSeconds": 30
    },

    "//AllowGuestLogin": "生产环境应设为 false：游客身份无法跨设备恢复",
    "AllowGuestLogin": true,

    "//WeChat": "微信小程序：Auth__WeChat__AppId / Auth__WeChat__AppSecret",
    "WeChat": {
      "AppId": "",
      "AppSecret": ""
    },

    "//Alipay": "支付宝小程序：除 AppId/AppSecret 外还需应用私钥（PKCS#8 Base64）用于 RSA2 签名",
    "Alipay": {
      "AppId": "",
      "AppSecret": "",
      "PrivateKey": ""
    },

    "//Douyin": "抖音小程序：Auth__Douyin__AppId / Auth__Douyin__AppSecret",
    "Douyin": {
      "AppId": "",
      "AppSecret": ""
    }
  },

  "Ai": {
    "//Provider": "Stub（本地桩，无外部依赖）或 OpenAiCompatible（真实模型）",
    "Provider": "Stub",

    "//BaseUrl": "通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1",
    "BaseUrl": "",
    "//ApiKey": "只从环境变量 Ai__ApiKey 或用户机密注入，绝不写入仓库",
    "ApiKey": "",

    "VisionModel": "qwen-vl-max",
    "TextModel": "deepseek-chat",
    "TimeoutSeconds": 30,

    "RecognizePerHour": 20,
    "RecognizePerDay": 100,
    "RecipePerDay": 30,

    "MaxImageBytes": 5242880,
    "AllowedImageExtensions": [".jpg", ".jpeg", ".png", ".webp"]
  },

  "DecisionEngine": {
    "Version": "1.0.0",

    "Weights": {
      "Taste": 0.25,
      "Freshness": 0.20,
      "Affinity": 0.15,
      "TimeSlot": 0.15,
      "Budget": 0.10,
      "Context": 0.10,
      "Exploration": 0.05
    },

    "Freshness": {
      "DishTauDays": 7.0,
      "CuisineTauDays": 10.0,
      "DishWeight": 0.7,
      "CuisineWeight": 0.3,
      "RecencyPower": 0.6,
      "FrequencyPower": 0.4,
      "FrequencyAlpha": 0.3
    },

    "Affinity": {
      "FreqCap": 10,
      "DefaultRatingScore": 0.5,
      "DefaultFreqScore": 0.3,
      "DefaultAgainRate": 0.5,
      "RatingWeight": 0.5,
      "FrequencyWeight": 0.3,
      "AgainWeight": 0.2
    },

    "Penalties": {
      "EatenWithin24h": 0.10,
      "Disliked": 0.25,
      "DislikedThreshold": 2.0,
      "Meh": 0.70,
      "MehThreshold": 3.0,
      "NeverAgain": 0.30
    },

    "ColdStart": {
      "MinRecordsForAffinity": 3,
      "PopularityBlend": 0.5
    },

    "TopN": {
      "Wheel": 8,
      "ResultList": 20,
      "DisplayList": 5
    },

    "Jitter": {
      "DefaultSigma": 0.0,
      "RefreshSigma": 3.0
    }
  }
}
