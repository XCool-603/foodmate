# ─────────────────────────────────────────────────────────────
#  换行符策略
#
#  ⚠️ 这个文件不是可选项：
#    · Linux 上的 shell 脚本必须是 LF，CRLF 会让 bash 直接报
#      「/usr/bin/env: 'bash\r': No such file or directory」
#    · Windows 上的 PowerShell 脚本用 CRLF 更自然
#  没有它，git 会按 core.autocrlf 做平台相关转换，
#  在 Windows 上 clone 再推到 Linux 就会把部署脚本弄坏。
# ─────────────────────────────────────────────────────────────

# 默认：文本文件一律 LF 存储，检出时也用 LF
* text=auto eol=lf

# ── Shell 脚本必须是 LF ───────────────────────────────────
*.sh            text eol=lf
*.bash          text eol=lf

# ── PowerShell 用 CRLF ────────────────────────────────────
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.psd1          text eol=crlf

# ── 源码与文档统一 LF ─────────────────────────────────────
*.cs            text eol=lf
*.csproj        text eol=lf
*.slnx          text eol=lf
*.props         text eol=lf
*.targets       text eol=lf
*.ts            text eol=lf
*.vue           text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.scss          text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sql           text eol=lf
*.env           text eol=lf
.env*           text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# ── 二进制：不做任何转换 ──────────────────────────────────
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.db            binary
*.pfx           binary
*.snk           binary

# ── 语言统计：标记为生成物，不计入仓库语言占比 ────────────
package-lock.json   linguist-generated=true
**/Migrations/*.Designer.cs  linguist-generated=true
**/Migrations/*ModelSnapshot.cs  linguist-generated=true
