# ─────────────────────────────────────────────────────────────
#  美食伴侣 · 环境变量模板
#
#  用法：
#    cp .env.example .env
#    然后填写下面的值。deploy/deploy.sh 会自动生成随机密钥。
#
#  ⚠️ .env 已被 .gitignore / .dockerignore 排除，绝不要提交到仓库。
# ─────────────────────────────────────────────────────────────

# ── 对外端口 ────────────────────────────────────────────────
API_PORT=8080

# ── 镜像标签（升级脚本会自动改这个值以便回滚）──────────────
IMAGE_TAG=latest

# ── 数据库 ──────────────────────────────────────────────────
POSTGRES_DB=foodmate
POSTGRES_USER=foodmate
# 必填。deploy.sh 会自动生成
POSTGRES_PASSWORD=

# ── 认证 ────────────────────────────────────────────────────
# 必填，至少 32 字节。deploy.sh 会自动生成
# 生成方式：openssl rand -base64 48
JWT_SIGNING_KEY=

ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=30

# 生产环境保持 false：游客身份无法跨设备恢复
ALLOW_GUEST_LOGIN=false

# ── 三端开放平台凭据（至少配一个，否则没有登录方式）─────────
WECHAT_APPID=
WECHAT_SECRET=

# 支付宝还需要应用私钥（PKCS#8 Base64），用于 RSA2 签名
ALIPAY_APPID=
ALIPAY_SECRET=
ALIPAY_PRIVATE_KEY=

DOUYIN_APPID=
DOUYIN_SECRET=

# ── AI ──────────────────────────────────────────────────────
# Stub = 本地桩（无外部依赖，识别结果与图片无关）
# OpenAiCompatible = 真实模型
AI_PROVIDER=Stub

# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=qwen-vl-max
AI_TEXT_MODEL=deepseek-chat
